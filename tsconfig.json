{
  // **插件源码**的类型配置。
  //
  // 关键一条：`pnpm build` 用 esbuild，它**只擦除类型、不检查类型**。这里定义的才是
  // 「类型对不对」这件事的唯一标准，靠 `pnpm typecheck`、`pnpm check:scripts`
  // 或编辑器来跑。
  //
  // 扩展名决定检不检：`include` 只列了 .ts/.tsx，因此从手写插件逐字搬来的 .js
  // 模块（见 src/kanban/）不会进类型检查 —— 它们本来就没有类型，报错只会是噪音。
  //
  // **构建脚本不在这里。** 它们要 Node 的类型（`process`、`fs`），而
  // `src/` 刻意不要 —— 见下面对 `types` 的说明。两者由 scripts/tsconfig.json
  // 分开管，`pnpm check:scripts` 跑那一份。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // 插件可以写 JSX，构建侧由 esbuild 的 jsx: 'automatic' 处理
    "jsx": "react-jsx",

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    // 不自动引入 node_modules/@types 下的全局声明：插件运行在宿主的 WebView 里，
    // 引入 Node 的全局只会让作者以为自己能用 fs、process 之类的东西。
    // （`import 'react'` 走的是模块解析，不受这条影响。）
    //
    // **这一条让"构建脚本也一起查"成为一个陷阱**：脚本要用 `process`，于是就得
    // 把 node 加进来，而加了之后 `src/` 里的 `process.exit()` 就不再报错。
    // 权限模型的核心是"插件做不到什么"，类型层不该把它自己的防线拆掉。
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts"]
}
