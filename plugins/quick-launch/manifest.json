{
  "name": "com.modulith.sample.quick-launch",
  "displayName": "快捷启动",
  "version": "1.0.1",
  "description": "把常用程序收在一处，点一下就打开。支持分组、多种视图、拖入添加、图标提取、备注与右键菜单；演示 process-spawn / filesystem-read 两项原生能力的用法。",
  "author": {
    "name": "环理论",
    "url": "https://github.com/Rinntheor"
  },
  "license": "MIT",
  "homepage": "https://github.com/Rinntheor/modulith-plugins/tree/main/plugins/quick-launch",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rinntheor/modulith-plugins.git"
  },
  "categories": [
    "示例",
    "效率"
  ],
  "keywords": [
    "sample",
    "launcher",
    "shortcut",
    "demo"
  ],
  "engines": {
    "loopcore": ">=1.0.0"
  },
  "main": "index.js",
  "style": "index.css",
  "icon": "icon.svg",
  "permissions": [
    "storage",
    "process-spawn",
    "filesystem-read"
  ],
  "sandboxLevel": 3,
  "contributes": {
    "modules": [
      {
        "id": "quick-launch",
        "name": "快捷启动",
        "description": "把常用程序收在一处，点一下就打开",
        "icon": "Rocket",
        "priority": 80
      }
    ]
  },
  "activationEvents": [
    "onModule:quick-launch"
  ]
}
