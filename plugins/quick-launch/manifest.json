{
  "name": "com.modulith.sample.quick-launch",
  "displayName": "快捷启动",
  "version": "1.1.0",
  "description": "把常用程序、快捷方式与网址收在一处，一下打开。支持分组（可折叠、标题随滚动常驻）、三种视图、搜索、固定与使用统计、单击/双击启动、方向键操作、图标提取、失效条目标记、配置的导入导出，以及把文件直接拖进来添加。",
  "author": {
    "name": "环理论",
    "url": "https://github.com/Rinntheor"
  },
  "license": "MIT",
  "homepage": "https://github.com/Rinntheor/modulith-plugins/tree/main/plugins/quick-launch",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rinntheor/modulith-plugins.git"
  },
  "categories": [
    "效率",
    "工具",
    "系统"
  ],
  "keywords": [
    "sample",
    "launcher",
    "shortcut",
    "demo"
  ],
  "engines": {
    "modulith": ">=1.6.0"
  },
  "runtime": "sandboxed",
  "main": "index.js",
  "style": "index.css",
  "icon": "icon.svg",
  "permissions": [
    "storage",
    "process-spawn",
    "filesystem-read"
  ],
  "contributes": {
    "modules": [
      {
        "id": "quick-launch",
        "name": "快捷启动",
        "description": "把常用程序与网址收在一处，点一下就打开",
        "icon": "Rocket",
        "priority": 80
      }
    ],
    "settings": [
      {
        "id": "launchOn",
        "label": "怎么算启动",
        "description": "「双击」是默认值，与这个插件一直以来的行为一致 —— 点一下只是选中，不会打开任何东西。改成「单击」之后鼠标一点到卡片就启动，用起来更快，但也更容易在只想选中时误触。",
        "type": "select",
        "default": "double",
        "options": [
          {
            "value": "double",
            "label": "双击"
          },
          {
            "value": "single",
            "label": "单击"
          }
        ]
      },
      {
        "id": "sortBy",
        "label": "排序",
        "description": "固定的条目在任何排序下都排在最前。「最近使用」与「最常使用」依据的是每次启动记录下来的次数与时间，从未启动过的条目排在后面。",
        "type": "select",
        "default": "manual",
        "options": [
          {
            "value": "manual",
            "label": "手动（添加顺序）"
          },
          {
            "value": "recent",
            "label": "最近使用"
          },
          {
            "value": "frequent",
            "label": "最常使用"
          },
          {
            "value": "name",
            "label": "按名称"
          }
        ]
      },
      {
        "id": "iconSize",
        "label": "图标大小",
        "description": "小 / 中 / 大。网格视图里「大」是 52 像素的图标，列表视图里会相应地收小一些，以保证一行仍然放得下名称与副标题。",
        "type": "select",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "小"
          },
          {
            "value": "medium",
            "label": "中"
          },
          {
            "value": "large",
            "label": "大"
          }
        ]
      },
      {
        "id": "showLabels",
        "label": "显示名称",
        "description": "关掉之后卡片上只留图标。适合已经认得出图标、希望一屏放下更多条目的情况；名称仍然在鼠标悬浮的提示与右键菜单里能看到。",
        "type": "boolean",
        "default": true
      },
      {
        "id": "density",
        "label": "密度",
        "description": "「宽松」是默认值。「紧凑」会缩小卡片的内边距与间距 —— 在列表与紧凑视图里效果最明显。",
        "type": "select",
        "default": "cozy",
        "options": [
          {
            "value": "cozy",
            "label": "宽松"
          },
          {
            "value": "tight",
            "label": "紧凑"
          }
        ]
      },
      {
        "id": "view",
        "label": "默认视图",
        "description": "打开这个面板时使用的视图。在面板里用顶部的分段控件切换视图也会更新这一项 —— 两处写的是同一个值。",
        "type": "select",
        "default": "grid",
        "options": [
          {
            "value": "grid",
            "label": "网格（大图标卡片）"
          },
          {
            "value": "list",
            "label": "列表（一行一条，带副标题）"
          },
          {
            "value": "compact",
            "label": "紧凑（更密的行）"
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onModule:quick-launch"
  ]
}
