  },
  "license": "MIT",
  "homepage": "https://github.com/Rinntheor/modulith-plugins/tree/main/plugins/color-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rinntheor/modulith-plugins.git"
  },
  "categories": [
    "开发",
    "效率"
  ],
  "keywords": [
    "color",
    "contrast",
    "wcag",
    "a11y",
    "oklch",
    "palette",
    "颜色",
    "对比度"
  ],
  "engines": {
    "loopcore": ">=1.0.0"
  },
  "main": "index.js",
  "style": "index.css",
  "icon": "icon.svg",
  "permissions": [
    "storage"
  ],
  "sandboxLevel": 1,
  "contributes": {
    "modules": [
      {
        "id": "colorLab",
        "name": "颜色与对比度",
        "displayName": "颜色与对比度",
        "description": "看清颜色的各种写法、推出一整套色阶、按 WCAG 算对比度",
        "icon": "icon.svg",
        "priority": 82
      }
    ]
  },
  "activationEvents": [
